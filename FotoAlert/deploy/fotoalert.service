[Unit]
Description=FotoAlert PWA – FastAPI Backend
After=network.target
Wants=network.target

[Service]
Type=simple
User=fotoalert
Group=fotoalert
WorkingDirectory=__APP_DIR__/FotoAlert/backend
ExecStart=__VENV_DIR__/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --timeout-keep-alive 75
Restart=always
RestartSec=5

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fotoalert

# Umgebung
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# TASK-25 Option A: On-Demand-Engine aktiv (Kalender live, Feed nur leicht-refresht)
Environment=FOTOALERT_ONDEMAND=1

# Sicherheit (TASK-102: erweitert um gaengige, fuer einen Python/FastAPI-Dienst
# unkritische systemd-Sandbox-Direktiven. ProtectSystem=full statt strict gewaehlt,
# weil WorkingDirectory (/opt/fotoalert/app/...) NICHT unter /usr, /boot oder /etc
# liegt und damit ohnehin beschreibbar bleibt -- kein ReadWritePaths= noetig, kein
# Risiko fuer den bestehenden Datenbank-/Bild-/Cache-Schreibzugriff unter data/.)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
